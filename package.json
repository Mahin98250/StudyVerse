{
  "name": "studyverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "StudyVerse — a personal academic operating system for CBSE Class 10.",
  "scripts": {
    "dev": "vite",
    "build": "npm run quality:academic && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "quality:academic": "node scripts/validate-academic-content.mjs"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0"
  }
}
